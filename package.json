{
  "name": "dsh-agent-guard",
  "version": "0.1.1",
  "description": "DSH pre-execute gate: ask before a tool call leaks a credential, stops a service, self-elevates into a root shell, or rewrites host network/registry state.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "guard",
    "safety",
    "credential",
    "pre-execute",
    "systemctl",
    "sudo"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
